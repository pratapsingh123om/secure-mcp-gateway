# Local Compose uses an explicitly development-only issuer. Production startup
# fails if DEV_AUTH_ENABLED is true or the public URL is not HTTPS.
GATEWAY_ENV=production
GATEWAY_PUBLIC_URL=https://mcp-gateway.example.com
DEV_AUTH_ENABLED=false

# External OIDC provider. Tokens must contain exp, iat, iss, aud, sub,
# tenant_id, roles, agent_id, and scope claims.
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=https://mcp-gateway.example.com/mcp
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
OIDC_REQUIRED_SCOPE=mcp:tools

OPA_URL=http://opa:8181/v1/data/mcp/authz/decision
OPA_HEALTH_URL=http://opa:8181/health
UPSTREAM_URLS_JSON={"crm":"http://crm:8001/mcp","hr":"http://hr:8002/mcp","billing":"http://billing:8003/mcp"}

# Supply these through a secret manager in production. Never put real values
# in this file or source control.
DOWNSTREAM_CREDENTIALS_JSON={"acme":{"crm":"REPLACE","hr":"REPLACE","billing":"REPLACE"}}

AUDIT_PATH=/var/lib/gateway/audit.jsonl
APPROVALS_PATH=/var/lib/gateway/approvals.db
MANIFESTS_PATH=/var/lib/gateway/manifests.json
ALLOWED_HOSTS=mcp-gateway.example.com
ALLOWED_ORIGINS=https://mcp-console.example.com
OTEL_CONSOLE_EXPORTER=false
